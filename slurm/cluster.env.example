# Copy to slurm/cluster.env and check the values (see docs/CLUSTER.md §1).
# Sourced by every SLURM script. Values below come from a known-working job on our cluster.

export PA_PARTITION="gpu"                 # partition with the GPU nodes
export PA_MODULES="anaconda3-2024"        # module that provides conda
export PA_CONDA_SH="/apps/compilers/anaconda3-2024/etc/profile.d/conda.sh"
export PA_CONDA_ENV="pagedattn"           # conda env created by setup_env.sh

# Large storage for models (~30 GB), caches and results.
# Change to your scratch/project directory if $HOME has a small quota (check: quota -s).
export PA_SCRATCH="$HOME/pa_data"

# Derived paths - normally no need to change
export HF_HOME="$PA_SCRATCH/hf_cache"
export PIP_CACHE_DIR="$PA_SCRATCH/pip_cache"
export TRITON_CACHE_DIR="$PA_SCRATCH/triton_cache"
export PA_RESULTS="$PA_SCRATCH/results"
